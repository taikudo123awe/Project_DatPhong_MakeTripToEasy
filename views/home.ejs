<%- include('partials/header') %>
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container text-center">
            <h1 class="hero-title">
                Chào mừng đến với Make Trip To Easy!
            </h1>
            <p class="hero-subtitle">
                <i class="fas fa-map-marked-alt"></i> Tìm kiếm và đặt phòng nghỉ dưỡng hoàn hảo cho chuyến đi của bạn
            </p>

            <!-- Search Bar -->
            <div class="search-container">
                <%- include('partials/search-bar') %>
            </div>

        </div>
    </section>

    <!-- Room List -->
    <main class="container mb-5">
        <section class="container my-5">
            <h2 style="color: var(--primary-blue); font-weight: 700;">
                <i class="fas fa-map-marker-alt"></i> Điểm đến đang thịnh hành
            </h2>
            <p style="color: var(--text-gray);">Các lựa chọn phổ biến nhất cho du khách tại Việt Nam</p>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-5 g-3">
                <% const destinations=[ { city: 'Hồ Chí Minh' ,image: 'images/hochiminh.jpeg' }, { city: 'Đà Nẵng' ,
                    image: 'images/danang.jpeg' }, { city: 'Hà Nội' , image: 'images/hanoi.jpeg' }, { city: 'Vũng Tàu'
                    ,image: 'images/vungtau.jpeg' }, { city: 'Đà Lạt' ,image: 'images/dalat.jpeg' }, ]; %>

                    <% destinations.forEach(dest=> { %>
                        <div class="col">
                            <a href="/rooms?city=<%= encodeURIComponent(dest.city) %>" class="text-decoration-none">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden hover-zoom">
                                    <img src="<%= dest.image %>" class="card-img-top" alt="<%= dest.city %>"
                                        style="height: 160px; object-fit: cover;">
                                    <div class="card-img-overlay d-flex align-items-end p-3"
                                        style="background: linear-gradient(transparent, rgba(0,0,0,0.6));">
                                        <h5 class="text-white fw-bold m-0">
                                            <%= dest.city %> <span style="font-size: 1rem;">🇻🇳</span>
                                        </h5>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <% }) %>
            </div>
        </section>

        <div class="row mb-4">
            <div class="col-12">
                <h2 style="color: var(--primary-blue); font-weight: 700;">
                    <i class="fas fa-hotel"></i> Phòng nổi bật
                </h2>
                <p style="color: var(--text-gray);">Khám phá những phòng nghỉ tuyệt vời dành cho bạn</p>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            <% if (rooms && rooms.length> 0) { %>
                <% rooms.forEach(room=> { %>
                    <div class="col">
                        <div class="room-card">
                            <div class="image-container">
                                <img src="/<%= (room.image ? room.image.split(';')[0] : 'uploads/default.jpg') %>"
                                    class="room-image w-100" alt="<%= room.roomName %>">

                                <% if (room.approvalStatus==='Đã duyệt' ) { %>
                                    <div class="image-overlay">
                                        <i class="fas fa-fire"></i> Hot
                                    </div>
                                    <% } %>
                            </div>
                            <div class="card-body">
                                <h5 class="room-title">
                                    <%= room.roomName %>
                                </h5>
                                <div class="rating">
                                    <span class="rating-stars">
                                        <i class="fas fa-star"></i>
                                        <%= room.rating || '4.5' %>
                                    </span>
                                    <span class="rating-count">( <%= room.reviewCount || 0 %> đánh giá )</span>
                                </div>
                                <p class="room-description">
                                    <%= room.description?.substring(0, 100) %>...
                                </p>
                                <div class="room-info">
                                    <div class="info-item">
                                        <i class="fas fa-users"></i>
                                        <span>Sức chứa: <%= room.capacity %> người</span>
                                    </div>
                                    <div class="info-item">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>
                                            <% if (room.address) { %>
                                                <%= room.address.district ? room.address.district + ', ' : '' %>
                                                    <%= room.address.city || '' %>
                                                        <% } else { %>
                                                            Không rõ
                                                            <% } %>
                                        </span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="room-price">
                                        <%= room.price.toLocaleString('vi-VN') %> <span class="price-unit">VND /
                                                đêm</span>
                                    </div>
                                </div>
                                <a href="/rooms/<%= room.roomId %>" class="btn btn-detail">
                                    <i class="fas fa-info-circle"></i> Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="text-center text-muted">Không có phòng nào để hiển thị</div>
                            <% } %>
        </div>
        <!-- Các địa danh du lịch nổi tiếng -->
        <section class="container my-5">
            <h2 style="color: var(--primary-blue); font-weight: 700;">
                <i class="fas fa-map-marked-alt text-primary"></i> Các địa danh du lịch nổi tiếng
            </h2>
            <p class="text-muted mb-4">Khám phá những điểm đến biểu tượng trải dài từ Bắc vào Nam Việt Nam</p>

            <div class="row g-4 justify-content-center">
                <!-- Vịnh Hạ Long -->
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/rooms?city=Quảng Ninh" class="text-decoration-none">
                        <div class="place-card">
                            <img src="/images/halong.jpeg" alt="Vịnh Hạ Long">
                        </div>
                        <div class="place-info">
                            <h5>Vịnh Hạ Long</h5>
                            <p>Quảng Ninh</p>
                        </div>
                    </a>
                </div>

                <!-- Động Phong Nha -->
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/rooms?city=Quảng Bình" class="text-decoration-none">
                        <div class="place-card">
                            <img src="/images/phongnha.jpeg" alt="Động Phong Nha - Kẻ Bàng">
                        </div>
                        <div class="place-info">
                            <h5>Phong Nha - Kẻ Bàng</h5>
                            <p>Quảng Bình</p>
                        </div>
                    </a>
                </div>

                <!-- Cố đô Huế -->
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/rooms?city=Thừa Thiên Huế" class="text-decoration-none">
                        <div class="place-card">
                            <img src="/images/hue.jpeg" alt="Cố đô Huế">
                        </div>
                        <div class="place-info">
                            <h5>Cố đô Huế</h5>
                            <p>Thừa Thiên Huế</p>
                        </div>
                    </a>
                </div>

                <!-- Bà Nà Hills -->
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/rooms?city=Đà Nẵng" class="text-decoration-none">
                        <div class="place-card">
                            <img src="/images/banahill.jpeg" alt="Bà Nà Hills">
                        </div>
                        <div class="place-info">
                            <h5>Bà Nà Hills</h5>
                            <p>Đà Nẵng</p>
                        </div>
                    </a>
                </div>

                <!-- Vinpearl Phú Quốc -->
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/rooms?city=Kiên Giang" class="text-decoration-none">
                        <div class="place-card">
                            <img src="/images/vinpearlphuquoc.jpeg" alt="Vinpearl Phú Quốc">
                        </div>
                        <div class="place-info">
                            <h5>Vinpearl Phú Quốc</h5>
                            <p>Kiên Giang</p>
                        </div>
                    </a>
                </div>

                <!-- Nhà thờ Đức Bà -->
                <div class="col-6 col-md-4 col-lg-2">
                    <a href="/rooms?city=Hồ Chí Minh" class="text-decoration-none">
                        <div class="place-card">
                            <img src="/images/nhathoducba.jpeg" alt="Nhà thờ Đức Bà">
                        </div>
                        <div class="place-info">
                            <h5>Nhà thờ Đức Bà</h5>
                            <p>TP. Hồ Chí Minh</p>
                        </div>
                    </a>
                </div>
            </div>
        </section>


        <!-- ƯU ĐÃI CUỐI TUẦN -->
        <section class="container my-5 weekend-section">
            <h2><i class="fa-solid fa-gift"></i> Ưu đãi cho cuối tuần</h2>
            <p>
                Tiết kiệm cho chỗ nghỉ từ ngày
                <%= new Date().getDate() + 1 %> tháng <%= new Date().getMonth() + 1 %> –
                        ngày <%= new Date().getDate() + 3 %> tháng <%= new Date().getMonth() + 1 %>
            </p>

            <div class="row">
                <% weekendDeals.forEach(deal=> { %>
                    <div class="col-md-3 mb-4">
                        <div class="deal-card">
                            <img src="<%= deal.image.split(';')[0] %>" alt="<%= deal.roomName %>">
                            <div class="card-body">
                                <h6>
                                    <%= deal.roomName %>
                                </h6>
                                <p class="text-muted small mb-1">
                                    <%= deal.address?.city || 'Không rõ' %>, Việt Nam
                                </p>

                                <div class="d-flex align-items-center mb-2">
                                    <span class="badge bg-info text-white me-2">
                                        <%= deal.avgRating %>
                                    </span>
                                    <small class="text-muted">
                                        <%= deal.reviewCount %> đánh giá
                                    </small>
                                </div>

                                <span class="badge bg-success mb-2">Ưu đãi <%= deal.discountPercent %>%</span>

                                <p class="mb-1">
                                    <span class="text-decoration-line-through text-danger me-2">
                                        VND <%= deal.oldPrice.toLocaleString() %>
                                    </span>
                                    <strong>VND <%= deal.price.toLocaleString() %></strong>
                                </p>
                                <small class="text-muted">2 đêm</small>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>
    <%- include('partials/footer') %>