<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Danh sách phòng có đánh giá</title>

  <!-- SIDEBAR + HEADER -->
  <link rel="stylesheet" href="/css/provider-sidebar.css" />
  <!-- CSS -->
  <link rel="stylesheet" href="/css/provider-reviews.css" />
  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
</head>

<body>

  <!-- ⭐ SIDEBAR + HEADER -->
    <% provider.providerName = provider.providerName || provider.name; %>
    <%- include('../partials/header-provider', { providerInfo, provider }) %>

    <h2 class="fw-bold mb-4">⭐ Phòng có đánh giá</h2>
  <!-- <a href="/provider/dashboard">&larr; Quay lại Dashboard</a> -->
  
  <div class="list-group mt-3">
    <% if (rooms.length > 0) { %>
      <% rooms.forEach(room => { %>
        <a href="/provider/reviews/<%= room.roomId %>" class="list-group-item list-group-item-action">
          <div class="d-flex w-100 justify-content-between">
            <h5 class="mb-1"><%= room.roomName %></h5>
            <small>Có <%= room.reviewCount %> đánh giá</small>
          </div>
          <p class="mb-1">Giá: <%= room.price.toLocaleString() %> VND</p>
        </a>
      <% }) %>
    <% } else { %>
      <p class="text-muted">Chưa có phòng nào của bạn có đánh giá.</p>
    <% } %>
  </div>
</body>
</html>