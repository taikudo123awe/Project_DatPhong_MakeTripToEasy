<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <title>Dashboard Nhà cung cấp · Make Trip To Easy</title>

    <link rel="stylesheet" href="/css/provider-sidebar.css" />
    <link rel="stylesheet" href="/css/provider-dashboard.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
  </head>

  <body>

  <!-- GỌI HEADER -->
  <%- include('../partials/header-provider', { providerInfo, provider }) %>
  <% if (success) { %>
  <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i>
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i>
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
        <h2 class="dashboard-title">📊 Dashboard Nhà cung cấp</h2>

        <!-- STAT CARDS -->
        <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-icon"><i class="fa-solid fa-bed"></i></div>
          <div>
            <div class="stat-label">Tổng phòng</div>
            <div class="stat-value"><%= providerRooms.length %></div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
          <div>
            <div class="stat-label">Đã duyệt</div>
            <div class="stat-value">
              <%= providerRooms.filter(function(r){ return r.approvalStatus ===
              'Đã duyệt'; }).length %>
            </div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
          <div>
            <div class="stat-label">Chờ duyệt</div>
            <div class="stat-value">
              <%= providerRooms.filter(function(r){ return r.approvalStatus ===
              'Chờ duyệt'; }).length %>
            </div>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div>
            <div class="stat-label">Tổng booking</div>
            <div class="stat-value">
              <%= pendingBookings.length + inUseBookings.length +
              completedBookings.length + cancelledBookings.length %>
            </div>
          </div>
        </div>
      </div>

      <!-- ADD ROOM BUTTON -->
      <div class="quick-add-box text-end">
        <a href="/provider/add-room" class="quick-add-btn small-btn">
          ➕ Thêm phòng mới
        </a>
      </div>

      <!-- TABLE -->
      <% if (providerRooms.length > 0) { %>
      <div class="table-wrapper">
        <table class="table custom-table text-center align-middle">
          <thead>
            <tr>
              <th>#</th>
              <th>Tên phòng</th>
              <th>Giá</th>
              <th>Trạng thái</th>
              <th>Ngày đăng</th>
              <th>Hành động</th>
            </tr>
          </thead>

          <tbody>
            <% providerRooms.forEach(function(room, index){ %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= room.roomName %></td>
              <td><%= room.price.toLocaleString() %></td>
              <td>
                <span
                  class="badge <%= room.approvalStatus === 'Chờ duyệt' ? 'badge-pending' : '' %> <%= room.approvalStatus === 'Đã duyệt' ? 'badge-approved' : '' %> <%= room.approvalStatus === 'Từ chối' ? 'badge-rejected' : '' %>"
                >
                  <%= room.approvalStatus %>
                </span>
              </td>
              <td>
                <%= new Date(room.postedAt).toLocaleDateString('vi-VN') %>
              </td>

              <td>
                <a
                  href="/provider/edit-room/<%= room.roomId %>"
                  class="btn btn-warning btn-sm me-2"
                  >🖋️</a
                >

                <form
                action="/provider/delete-room/<%= room.roomId %>"
                method="POST"
                style="display: inline"
                onsubmit="return confirm('Bạn có chắc chắn muốn ẨN phòng này không?');"
              >
                <button class="btn btn-danger btn-sm">❌</button>
              </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% } else { %>
          <p class="text-muted mt-3">Bạn chưa đăng phòng nào.</p>
        <% } %>
    </div> <!-- END provider-content -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>