<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/detail.css" />

<main class="room-detail-wrapper container-fluid p-0">

  <div class="room-detail-card">

    <!-- ============================
         HÀNG 1: GALLERY + GIÁ / ĐẶT PHÒNG
    ============================= -->
    <div class="row g-0">
      
      <!-- GALLERY BÊN TRÁI -->
      <div class="col-lg-6 p-0">
        <% if (room.image) { 
             const imgs = room.image.split(";").filter(i => i.trim() !== ""); 
             const total = imgs.length; 
        %>

          <div class="image-gallery">
            <!-- ẢNH CHÍNH -->
            <div class="main-image" onclick="openLightbox(0)">
              <img src="/<%= imgs[0] %>" alt="Ảnh phòng chính" />
            </div>

            <!-- ẢNH PHỤ -->
            <div class="sub-images">
              <% imgs.slice(1, 5).forEach((img, index) => { 
                   const globalIndex = index + 1; 
              %>

                <% if (index === 3 && total > 5) { %>
                  <div class="sub-image more-overlay" data-text="+<%= total - 4 %> ảnh">
                    <img src="/<%= img %>" />
                  </div>
                <% } else { %>
                  <div class="sub-image" onclick="openLightbox(<%= globalIndex %>)">
                    <img src="/<%= img %>" />
                  </div>
                <% } %>

              <% }) %>
            </div>
          </div>

        <% } else { %>
          <div class="no-image-box text-center p-5">
            <i class="fa-solid fa-image fa-3x mb-3"></i>
            <p>Phòng này chưa có hình ảnh.</p>
          </div>
        <% } %>
      </div>

      <!-- GIÁ + NÚT ĐẶT PHÒNG (BÊN PHẢI) -->
      <div class="col-lg-6 p-4 d-flex flex-column justify-content-center">
        
        <!-- Tên phòng -->
        <h1 class="room-title mb-3">
          <i class="fa-solid fa-bed me-2"></i>
          <%= room.roomName %>
        </h1>

        <!-- Giá -->
        <div class="room-price-box mb-3">
          <div>
            <span class="price-label">Giá mỗi đêm</span>
            <div class="price-main">
              <span class="price-value"><%= room.price.toLocaleString() %></span>
              <span class="price-currency">VND / đêm</span>
            </div>
          </div>
          <div class="price-badge">
            <i class="fa-solid fa-bolt-lightning me-1"></i> Giá tốt hôm nay
          </div>
        </div>

        <!-- Nút đặt -->
        <a
          href="/customer/bookings/<%= room.roomId %>?checkInDate=<%= checkInDate %>&checkOutDate=<%= checkOutDate %>&numberOfGuests=<%= numberOfGuests %>&quantity=<%= quantity %>"
          class="btn btn-primary px-4 py-2"
        >
          <i class="fa-solid fa-calendar-check me-2"></i> Đặt phòng ngay
        </a>

        <a href="/" class="btn btn-outline-secondary mt-3 px-4">
          <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
        </a>

      </div>
    </div>

    <!-- ============================================
         HÀNG 2: TOÀN BỘ NỘI DUNG PHÒNG (FULL WIDTH)
    ============================================= -->
    <div class="room-info-wrapper container mt-4">

      <!-- Pills -->
      <div class="room-pill-row">
        <span class="pill pill-primary"><i class="fa-solid fa-bed me-1"></i> Phòng nghỉ</span>

        <% if (room.Reviews && room.Reviews.length > 0) { 
             const avgRating = (
               room.Reviews.reduce((s, r) => s + r.rating, 0) / room.Reviews.length
             ).toFixed(1);
        %>
          <span class="pill pill-rating">
            <i class="fa-solid fa-star me-1"></i>
            <%= avgRating %> / 5 • <%= room.Reviews.length %> đánh giá
          </span>
        <% } else { %>
          <span class="pill pill-muted">
            <i class="fa-regular fa-star me-1"></i> Chưa có đánh giá
          </span>
        <% } %>
      </div>

      <!-- Địa chỉ + sức chứa -->
      <ul class="room-meta list-unstyled mt-2">
        <li><i class="fa-solid fa-location-dot icon-location"></i> <strong>Địa chỉ:</strong> <%= room.fullAddress %></li>
        <li><i class="fa-solid fa-user-group icon-capacity"></i> <strong>Sức chứa:</strong> <%= room.capacity %> người</li>
      </ul>

      <!-- 🔹 TIỆN ÍCH THEO LOẠI -->
      <div class="room-section mt-3">
        <h5 class="section-title">
          <i class="fa-solid fa-wifi me-2"></i> Tiện ích phòng
        </h5>

        <% if (room.Amenities && room.Amenities.length > 0) { %>

          <% 
            const grouped = {};
            room.Amenities.forEach(a => {
              if (!grouped[a.category]) grouped[a.category] = [];
              grouped[a.category].push(a);
            });
          %>

          <% Object.keys(grouped).forEach(cat => { %>
            <h6 class="mt-3 fw-bold text-primary"><%= cat %></h6>

            <div class="amenity-grid">
              <% grouped[cat].forEach(a => { %>
                <div class="amenity-item">
                  <i class="fa-solid fa-circle-check"></i>
                  <span><%= a.amenityName %></span>
                </div>
              <% }) %>
            </div>
          <% }) %>

        <% } else { %>
          <p class="text-muted">Chưa có tiện ích.</p>
        <% } %>
      </div>


      <!-- Mô tả -->
      <div class="room-section mt-3">
        <h5 class="section-title"><i class="fa-solid fa-circle-info me-2"></i>Mô tả phòng</h5>
        <p><%= room.description %></p>
      </div>

      <!-- Nhà cung cấp -->
      <div class="room-section mt-4 provider-box">
        <h5 class="section-title mb-2">
          <i class="fa-solid fa-user-tie me-2"></i>Nhà cung cấp
        </h5>
        <p><strong>Tên:</strong> <%= room.Provider?.providerName %></p>
        <p><strong>Email:</strong> <%= room.Provider?.email %></p>
        <p><strong>SĐT:</strong> <%= room.Provider?.phoneNumber %></p>
      </div>

      <!-- Review -->
      <div class="room-section mt-4">
        <h5 class="section-title mb-3">
          <i class="fa-solid fa-comments me-2"></i>Đánh giá từ khách hàng
        </h5>

        <% if (room.Reviews?.length) { %>
          <% const avg = (room.Reviews.reduce((s,r)=>s+r.rating,0)/room.Reviews.length).toFixed(1); %>

          <div class="rating-summary mb-3">
            <div class="rating-number">
              <span class="rating-score"><%= avg %></span><span class="rating-max">/ 5</span>
            </div>
            <small class="text-muted">Dựa trên <%= room.Reviews.length %> lượt đánh giá</small>
          </div>

          <div class="list-group review-list shadow-sm">
          <% room.Reviews.forEach(r => { %>
            <div class="list-group-item review-item">

              <!-- KHÁCH HÀNG -->
              <strong><i class="fa-solid fa-user-circle me-1"></i> <%= r.Customer?.fullName %></strong>
              <span class="badge badge-rating d-inline-flex align-items-center gap-1">
                <% for (let i = 1; i <= 5; i++) { %>
                  <% if (i <= r.rating) { %>
                    <i class="fa-solid fa-star text-warning"></i>
                  <% } else { %>
                    <i class="fa-regular fa-star text-warning"></i>
                  <% } %>
                <% } %>
              </span>

              <p class="mt-2"><%= r.comment %></p>

              <!-- ⭐ PHẢN HỒI CỦA NHÀ CUNG CẤP -->
              <% if (r.Feedback) { %>
                <div class="provider-feedback mt-3 p-3">
                  <div class="feedback-header">
                    <i class="fa-solid fa-reply text-primary me-2"></i>
                    <strong>Phản hồi từ nhà cung cấp</strong>
                  </div>
                  <p class="mt-2 mb-1"><%= r.Feedback.message %></p>
                  <small class="text-muted">
                    <i class="fa-regular fa-clock me-1"></i>
                    <%= new Date(r.Feedback.feedbackDate).toLocaleDateString('vi-VN') %>
                  </small>
                </div>
              <% } else { %>
                <p class="text-muted mt-2">
                  <i class="fa-regular fa-comment-dots me-1"></i>
                  Nhà cung cấp chưa phản hồi.
                </p>
              <% } %>

            </div>
          <% }) %>
        </div>

        <% } else { %>
          <p class="text-muted">Chưa có đánh giá nào.</p>
        <% } %>
      </div>

    </div>

  </div>
</main>


<!-- LIGHTBOX -->
<div id="lightbox" class="lightbox">
  <span class="close-btn" onclick="closeLightbox()">&times;</span>
  <img id="lightbox-img" />
  <button class="prev-btn" onclick="changeImage(-1)">&#10094;</button>
  <button class="next-btn" onclick="changeImage(1)">&#10095;</button>
</div>

<script id="room-data" type="application/json">
  <%- JSON.stringify(room.image ? room.image.split(";").filter(i => i.trim() !== "") : []) %>
</script>

<script src="/javascript/detail.js"></script>
<%- include('../partials/footer') %>
