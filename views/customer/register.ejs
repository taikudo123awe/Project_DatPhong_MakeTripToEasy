<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng ký - MakeTripToEasy</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/styles/customer/register.css">
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="fas fa-plane-departure"></i> Make Trip To Easy
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Trang chủ</a></li>
          <li class="nav-item"><a class="nav-link" href="/rooms">Tìm phòng</a></li>
          <li class="nav-item"><a class="nav-link" href="/about">Về chúng tôi</a></li>
          <li class="nav-item"><a class="nav-link btn-login" href="/customer/login">Đăng nhập</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Register Page (dùng wrapper y như login) -->
  <div class="login-page">
    <div class="login-wrapper">
      <!-- Left Side - Info (giữ nguyên nội dung bên login cho đồng bộ) -->
      <div class="info-section">
        <div class="info-header">
          <h1>Nền tảng cung cấp chỗ ở khi đi du lịch hàng đầu Việt Nam</h1>
          <p>Kết nối hàng nghìn chủ nhà và người thuê trên toàn quốc với giải pháp tìm kiếm thông minh, an toàn và hiệu
            quả.</p>
        </div>

        <div class="info-features">
          <div class="info-item">
            <div class="info-icon"><i class="fas fa-shield-alt"></i></div>
            <div class="info-content">
              <h3>Bảo mật tuyệt đối</h3>
              <p>Thông tin cá nhân được mã hóa và bảo vệ theo tiêu chuẩn quốc tế</p>
            </div>
          </div>
          <div class="info-item">
            <div class="info-icon"><i class="fas fa-search"></i></div>
            <div class="info-content">
              <h3>Tìm kiếm thông minh</h3>
              <p>Công nghệ AI giúp tìm phòng phù hợp với nhu cầu của bạn</p>
            </div>
          </div>
          <div class="info-item">
            <div class="info-icon"><i class="fas fa-headset"></i></div>
            <div class="info-content">
              <h3>Hỗ trợ 24/7</h3>
              <p>Đội ngũ chăm sóc khách hàng luôn sẵn sàng hỗ trợ bạn mọi lúc</p>
            </div>
          </div>
        </div>

        <div class="info-stats">
          <div class="stat-item">
            <span class="stat-value">50K+</span>
            <span class="stat-label">Phòng trọ</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">100K+</span>
            <span class="stat-label">Người dùng</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">4.8/5</span>
            <span class="stat-label">Đánh giá</span>
          </div>
        </div>
      </div>

      <!-- Right Side - Register Form -->
      <div class="form-section">
        <div class="form-header">
          <h2>Đăng ký</h2>
          <p>Nhập thông tin để tạo tài khoản của bạn</p>
        </div>

        <!-- Alert Messages -->
        <% if (typeof success !=='undefined' && success) { %>
          <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            <span>
              <%= success %>
            </span>
          </div>
          <% } %>

            <% if (typeof error !=='undefined' && error) { %>
              <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <span>
                  <%= error %>
                </span>
              </div>
              <% } %>

                <!-- Register Form -->
                <form method="POST" action="/register" id="registerForm" onsubmit="return validateRegister()">
                  <div class="form-group">
                    <label class="form-label" for="fullName">Họ và tên</label>
                    <div class="input-group">
                      <i class="input-icon fas fa-user"></i>
                      <input type="text" class="form-control" id="fullName" name="fullName"
                        value="<%= (form && form.fullName) || '' %>" required>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="email">Email (dùng làm tên đăng nhập)</label>
                    <div class="input-group">
                      <i class="input-icon fas fa-envelope"></i>
                      <input type="email" class="form-control" id="email" name="email"
                        value="<%= (form && form.email) || '' %>" required>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="phoneNumber">Số điện thoại</label>
                    <div class="input-group">
                      <i class="input-icon fas fa-phone"></i>
                      <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber"
                        pattern="^0[0-9]{8,11}$" title="Số điện thoại phải bắt đầu bằng 0 và có 9–12 chữ số"
                        value="<%= (form && form.phoneNumber) || '' %>" required>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="identityNumber">CMND/CCCD</label>
                    <div class="input-group">
                      <i class="input-icon fas fa-id-card"></i>
                      <input type="text" class="form-control" id="identityNumber" name="identityNumber"
                        pattern="^[0-9]{9,12}$" title="Chỉ gồm 9-12 chữ số"
                        value="<%= (form && form.identityNumber) || '' %>" required>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="password">Mật khẩu</label>
                    <div class="input-group">
                      <i class="input-icon fas fa-lock"></i>
                      <input type="password" class="form-control" id="password" name="password" minlength="6"
                        autocomplete="new-password" required>
                      <i class="password-toggle fas fa-eye" onclick="togglePassword('password', this)"></i>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="confirmPassword">Xác nhận mật khẩu</label>
                    <div class="input-group">
                      <i class="input-icon fas fa-lock"></i>
                      <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                        minlength="6" autocomplete="new-password" required>
                      <i class="password-toggle fas fa-eye" onclick="togglePassword('confirmPassword', this)"></i>
                    </div>
                    <div class="form-text" id="confirmHelp" style="display:none;color:#dc3545">
                      Mật khẩu xác nhận không khớp.
                    </div>
                  </div>

                  <button type="submit" class="btn-login">Đăng ký</button>

                  <div class="divider"><span>hoặc</span></div>

                  <div class="social-login" style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">
                    <button type="button"
                      class="btn btn-white border d-flex align-items-center justify-content-center gap-2">
                      <i class="fab fa-google"></i> Google
                    </button>
                    <button type="button"
                      class="btn btn-white border d-flex align-items-center justify-content-center gap-2">
                      <i class="fab fa-facebook-f"></i> Facebook
                    </button>
                  </div>

                  <div class="register-link text-center mt-4" style="color:#64748b;font-size:.9375rem;">
                    Đã có tài khoản? <a href="/customer/login"
                      style="color:#0ea5e9;text-decoration:none;font-weight:600;">Đăng nhập</a>
                  </div>
                </form>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="login-footer">
    <div class="container">
      © 2025 MakeTripToEasy. All rights reserved.
      <a href="/terms">Điều khoản</a>
      <a href="/privacy">Bảo mật</a>
      <a href="/help">Trợ giúp</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function togglePassword(id, toggleIcon) {
      const input = document.getElementById(id);
      if (input.type === 'password') {
        input.type = 'text';
        toggleIcon.classList.remove('fa-eye');
        toggleIcon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        toggleIcon.classList.remove('fa-eye-slash');
        toggleIcon.classList.add('fa-eye');
      }
    }

    function validateRegister() {
      const pass = document.getElementById('password').value.trim();
      const conf = document.getElementById('confirmPassword').value.trim();
      const help = document.getElementById('confirmHelp');
      if (pass !== conf) {
        help.style.display = 'block';
        return false;
      }
      help.style.display = 'none';

      // Prevent double submit
      const btn = document.querySelector('.btn-login');
      if (btn.disabled) return false;
      btn.disabled = true;
      btn.textContent = 'Đang xử lý...';
      setTimeout(() => {
        btn.disabled = false;
        btn.textContent = 'Đăng ký';
      }, 5000);
      return true;
    }
  </script>
</body>

</html>