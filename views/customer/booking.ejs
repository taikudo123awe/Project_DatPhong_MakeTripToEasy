<%- include('../partials/header') %>

<style>
  :root {
    --primary: #2f9ed5;
    --primary-dark: #2f9ed5;
    --primary-light: #2781ad;
    --accent: #00A0DC;
    --success: #138c54;
    --background: #F3F6F8;
    --card-bg: #FFFFFF;
    --text-primary: #000000DE;
    --text-secondary: #00000099;
    --border: #0000001F;
    --shadow-sm: 0 1px 2px 0 rgba(0,0,0,0.05);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background: var(--background);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: var(--text-primary);
    line-height: 1.6;
  }

  .booking-wrapper {
    min-height: 100vh;
    padding: 3rem 1rem;
  }

  .booking-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 2rem;
    align-items: start;
  }

  /* Main Content */
  .main-content {
    background: var(--card-bg);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .page-header {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    padding: 2.5rem 2rem;
    color: white;
  }

  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .page-header .subtitle {
    opacity: 0.95;
    font-size: 1rem;
    font-weight: 400;
  }

  .content-section {
    padding: 2rem;
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-grid {
    display: grid;
    gap: 1rem;
  }

  .detail-item {
    display: flex;
    align-items: center;
    padding: 1rem;
    background: var(--background);
    border-radius: 8px;
    transition: all 0.2s;
  }

  .detail-item:hover {
    background: #E8F4F8;
  }

  .detail-icon {
    width: 40px;
    height: 40px;
    background: var(--primary);
    color: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 1rem;
    flex-shrink: 0;
  }

  .detail-content {
    flex: 1;
  }

  .detail-label {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .detail-value {
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .amenity-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: white;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .amenity-badge i {
    color: var(--primary);
  }

  /* Sidebar */
  .booking-sidebar {
    position: sticky;
    top: 1rem;
  }

  .summary-card {
    background: var(--card-bg);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .summary-header {
    padding: 1.5rem;
    background: var(--primary);
    color: white;
  }

  .summary-header h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .summary-body {
    padding: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.9375rem;
    transition: all 0.2s;
    background: white;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(10, 102, 194, 0.1);
  }

  .form-help {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .price-breakdown {
    margin: 1.5rem 0;
    padding: 1.5rem;
    background: var(--background);
    border-radius: 8px;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    font-size: 0.9375rem;
  }

  .price-row:not(:last-child) {
    border-bottom: 1px solid var(--border);
  }

  .price-total {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 2px solid var(--primary);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary);
  }

  .btn {
    width: 100%;
    padding: 1rem;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .btn-primary {
    background: var(--success);
    color: white;
    margin-bottom: 0.75rem;
  }

  .btn-primary:hover {
    background: #046239;
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .btn-secondary {
    background: white;
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: var(--background);
  }

  .info-box {
    margin-top: 1.5rem;
    padding: 1.25rem;
    background: #E8F4F8;
    border-left: 3px solid var(--primary);
    border-radius: 6px;
  }

  .info-box-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .info-box ul {
    list-style: none;
    padding: 0;
  }

  .info-box li {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    padding: 0.375rem 0;
    padding-left: 1.25rem;
    position: relative;
  }

  .info-box li:before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
  }

  @media (max-width: 992px) {
    .booking-container {
      grid-template-columns: 1fr;
    }

    .booking-sidebar {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .booking-wrapper {
      padding: 1.5rem 1rem;
    }

    .page-header {
      padding: 1.5rem 1rem;
    }

    .page-header h1 {
      font-size: 1.5rem;
    }

    .content-section {
      padding: 1.5rem 1rem;
    }

    .detail-grid {
      grid-template-columns: 1fr;
    }

    .amenities-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="booking-wrapper">
  <div class="booking-container">
    <!-- Main Content -->
    <div class="main-content">
      <div class="page-header">
        <h1>
          <i class="fa-solid fa-clipboard-check"></i>
          Xác nhận đặt phòng
        </h1>
        <p class="subtitle"><%= room.roomName %></p>
      </div>

      <!-- Room Information -->
      <div class="content-section">
        <h2 class="section-title">
          <i class="fa-solid fa-door-open"></i>
          Thông tin phòng
        </h2>
        
        <div class="detail-grid">
          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-bed"></i>
            </div>
            <div class="detail-content">
              <div class="detail-label">Loại phòng</div>
              <div class="detail-value"><%= room.roomName %></div>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-users"></i>
            </div>
            <div class="detail-content">
              <div class="detail-label">Sức chứa tối đa</div>
              <div class="detail-value"><%= room.capacity %> khách</div>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-expand"></i>
            </div>
            <div class="detail-content">
              <div class="detail-label">Diện tích</div>
              <div class="detail-value"><%= room.size || '25m²' %></div>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-tag"></i>
            </div>

            <div class="detail-content">
              <div class="detail-label">Giá phòng</div>
              <div class="detail-value">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' })
                      .format(room.pricePerNight || room.price) %> / đêm
              </div>
            </div>

            <div class="detail-content">
              <div class="detail-label">Tổng giá (<span id="nightCount">1</span> đêm)</div>
              <div class="detail-value" id="totalPrice">
                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' })
                      .format(room.pricePerNight || room.price) %>
              </div>
            </div>
          </div>

        </div>

        <%
          let amenities = [];
          if (room && typeof room.amenities === 'string') {
            amenities = room.amenities.split(',');
          } else if (room && Array.isArray(room.amenities)) {
            amenities = room.amenities;
          }
        %>
        <% if (amenities.length > 0) { %>
        <div style="margin-top: 2rem;">
          <div class="detail-label" style="margin-bottom: 1rem; font-size: 0.875rem;">TIỆN NGHI PHÒNG</div>
          <div class="amenities-grid">
            <% amenities.forEach(function(amenity) { %>
              <div class="amenity-badge">
                <i class="fa-solid fa-check"></i>
                <%= amenity.trim() %>
              </div>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>

      <% if (checkInDate && checkOutDate && numberOfGuests) { %>
      <!-- Booking Details -->
      <div class="content-section" style="border-top: 1px solid var(--border);">
        <h2 class="section-title">
          <i class="fa-solid fa-calendar-days"></i>
          Chi tiết đặt phòng
        </h2>
        
        <div class="detail-grid">
          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div class="detail-content">
              <div class="detail-label">Ngày nhận phòng</div>
              <div class="detail-value"><%= new Date(checkInDate).toLocaleDateString('vi-VN', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></div>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-calendar-xmark"></i>
            </div>
            <div class="detail-content">
              <div class="detail-label">Ngày trả phòng</div>
              <div class="detail-value"><%= new Date(checkOutDate).toLocaleDateString('vi-VN', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></div>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-moon"></i>
            </div>
            <div class="detail-content">
              <div class="detail-label">Tổng số đêm</div>
              <div class="detail-value"><%= Math.ceil((new Date(checkOutDate) - new Date(checkInDate)) / (1000 * 60 * 60 * 24)) %> đêm</div>
            </div>
          </div>

          <div class="detail-item">
            <div class="detail-icon">
              <i class="fa-solid fa-user-group"></i>
            </div>
            <div class="detail-content">
              <div class="detail-label">Số lượng khách</div>
              <div class="detail-value"><%= numberOfGuests %> người</div>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Important Information -->
      <div class="content-section" style="border-top: 1px solid var(--border);">
        <div class="info-box">
          <div class="info-box-title">
            <i class="fa-solid fa-circle-info"></i>
            Điều khoản & chính sách
          </div>
          <ul>
            <li>Thời gian nhận phòng: 14:00 | Trả phòng: 12:00</li>
            <li>Yêu cầu xuất trình CMND/CCCD/Hộ chiếu hợp lệ khi check-in</li>
            <li>Miễn phí hủy đặt phòng trước 6 giờ</li>
            <li>Nghiêm cấm hút thuốc trong khu vực phòng nghỉ</li>
            <li>Thanh toán toàn bộ khi nhận phòng hoặc đặt cọc trước 30%</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="booking-sidebar">
      <form action="/customer/bookings/<%= room.roomId %>" method="POST">
        <div class="summary-card">
          <div class="summary-header">
            <h3>Tóm tắt đơn đặt phòng</h3>
          </div>
          <img src="/<%= (room.image ? room.image.split(';')[0] : 'uploads/default.jpg') %>"
                                    class="room-image w-100" alt="<%= room.roomName %>">
          <div class="summary-body">
            <% if (checkInDate && checkOutDate && numberOfGuests) { %>
              <input type="hidden" name="checkInDate" value="<%= checkInDate %>">
              <input type="hidden" name="checkOutDate" value="<%= checkOutDate %>">
              <input type="hidden" name="numberOfGuests" value="<%= numberOfGuests %>">

              <% if (quantity) { %>
                <input type="hidden" name="quantity" value="<%= quantity %>">
              <% } else { %>
                <div class="form-group">
                  <label for="quantity" class="form-label">Số lượng phòng</label>
                  <input type="number" id="quantity" name="quantity" class="form-control" 
                         min="1" max="<%= room.availableRooms || 1 %>" value="1" required>
                  <div class="form-help">
                    <i class="fa-solid fa-circle-info"></i>
                    Còn <%= room.availableRooms %> phòng trống
                  </div>
                </div>
              <% } %>

              <% 
                const nights = Math.ceil((new Date(checkOutDate) - new Date(checkInDate)) / (1000 * 60 * 60 * 24));
                const roomQuantity = quantity || 1;
                const subtotal = room.pricePerNight * nights * roomQuantity;
                const tax = subtotal * 0.1;
                const total = subtotal + tax;
              %>

              <div class="price-breakdown">
                <div class="price-row">
                  <span>Giá phòng × <%= nights %> đêm</span>
                  <span><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(subtotal) %></span>
                </div>
                <div class="price-row">
                  <span>Thuế VAT (10%)</span>
                  <span><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(tax) %></span>
                </div>
                <div class="price-row price-total">
                  <span>Tổng cộng</span>
                  <span><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total) %></span>
                </div>
              </div>

            <% } else { %>
              <div class="form-group">
                <label class="form-label">Ngày nhận - trả phòng</label>
                <!-- <input type="text" id="dateRange" class="form-control" readonly placeholder="Chọn ngày"> -->
                <input type="text" id="dateRange" class="form-control" readonly placeholder="Chọn ngày" data-price="<%= room.pricePerNight || room.price %>" >
                <input type="hidden" name="checkInDate" id="checkInDate">
                <input type="hidden" name="checkOutDate" id="checkOutDate">
              </div>

              <div class="form-group">
                <label for="quantity" class="form-label">Số lượng phòng</label>
                <input type="number" id="quantity" name="quantity" class="form-control" 
                       min="1" max="<%= room.availableRooms || 1 %>" value="1" required>
                <div class="form-help">
                  <i class="fa-solid fa-circle-info"></i>
                  Còn <%= room.availableRooms %> phòng trống
                </div>
              </div>
            <% } %>

            <!-- Thông tin khách hàng -->
            <div class="form-group" style="border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1rem;">
              <h4 style="font-size: 1rem; font-weight: 600; color: var(--primary); margin-bottom: 1rem;">
                <i class="fa-solid fa-user me-2"></i> Thông tin người đặt phòng
              </h4>

              <% if (customer) { %>
                <div class="detail-value"><strong>Họ tên:</strong> <%= customer.fullName %></div>
                <div class="detail-value"><strong>Email:</strong> <%= customer.email %></div>
                <div class="detail-value"><strong>Số điện thoại:</strong> <%= customer.phoneNumber %></div>

                <!-- Ẩn để gửi kèm form -->
                <input type="hidden" name="customerId" value="<%= customer.customerId %>">
              <% } else { %>
                <div class="alert alert-warning" style="background:#fff3cd; color:#856404; border-radius:6px; padding:10px;">
                  Bạn chưa đăng nhập. <a href="/customer/login" style="color:#0d6efd;">Đăng nhập ngay</a> để đặt phòng.
                </div>
              <% } %>
            </div>
            <% if (error) { %>
              <div class="alert alert-danger" 
                  style="background:#f8d7da; color:#842029; padding:12px; border-radius:6px; margin: 15px 0;">
                <i class="fa-solid fa-circle-exclamation"></i>
                <%= error %>
              </div>
            <% } %>
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-check"></i>
              Xác nhận đặt phòng
            </button>

            <button type="button" class="btn btn-secondary" onclick="window.history.back()">
              <i class="fa-solid fa-arrow-left"></i>
              Quay lại
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css">
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<script src="/javascript/dateRangePicker.js"></script>

<%- include('../partials/footer') %>