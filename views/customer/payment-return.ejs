<%- include('../partials/header') %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<main class="container mt-5 text-center">
    <div class="card p-4 shadow-sm" style="max-width: 600px; margin: auto;">
        <% if (message.includes('thất bại') || message.includes('không hợp lệ')) { %>
            <i class="fas fa-times-circle fa-4x text-danger my-3"></i>
            <h2 class="text-danger">Thanh toán thất bại</h2>
            <p class="mt-3"><%= message %></p>
        <% } else { %>
            <i class="fas fa-check-circle fa-4x text-success my-3"></i>
            <h2 class="text-success">Giao dịch đang được xử lý</h2>
            <p class="mt-3"><%= message %></p>
            <p>Vui lòng kiểm tra lại trang "Phiếu đặt phòng" sau vài phút.</p>
        <% } %>
        <a href="/customer/history" class="btn btn-primary mt-3">Quay lại Lịch sử đặt phòng</a>
    </div>
</main>

<%- include('../partials/footer') %>