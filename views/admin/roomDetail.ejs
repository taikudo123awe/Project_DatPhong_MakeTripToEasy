<%- include('../partials/header-admin') %>

<div class="detail-container">

    <!-- Back Button -->
    <a href="/admin/rooms" class="back-button">Quay lại danh sách</a>

    <!-- Page Header -->
    <div class="page-header-detail">
        <h1 class="page-title-detail">Chi tiết phòng #<%= room.roomId %></h1>
    </div>

    <!-- Detail Card -->
    <div class="detail-card">
        <!-- ROOM NAME -->
        <div class="info-group">
            <span class="info-label">Tên phòng</span>
            <div class="info-value large"><%= room.roomName %></div>
        </div>

        <!-- ROOM IMAGES -->
        <div class="info-group">
            <span class="info-label">Hình ảnh phòng</span>
            <div class="image-gallery">
                <% let imgs = room.image ? room.image.split(';') : []; %>
                <% if (imgs.length > 0) { %>
                    <img src="/<%= imgs[0].trim() %>" class="room-image-single">
                <% } else { %>
                    <p class="text-muted">Không có hình ảnh</p>
                <% } %>
            </div>
        </div>

        <!-- ADDRESS -->
        <div class="info-group">
            <span class="info-label">Địa chỉ</span>
            <div class="info-value"><%= room.fullAddress || 'Không có địa chỉ' %></div>
        </div>

        <!-- CAPACITY -->
        <div class="info-group">
            <span class="info-label">Sức chứa</span>
            <div class="info-value"><%= room.capacity %> người</div>
        </div>

        <!-- AVAILABLE ROOMS -->
        <div class="info-group">
            <span class="info-label">Số phòng còn trống</span>
            <div class="info-value"><%= room.availableRooms %></div>
        </div>

        <!-- AMENITIES -->
        <div class="info-group">
            <span class="info-label">Tiện ích</span>
            <div class="info-value">
                <% if (room.amenities) { %>
                    <ul class="amenities-list">
                        <% room.amenities.split(',').forEach(a => { %>
                            <li><%= a.trim() %></li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <span class="text-muted">Không có tiện ích</span>
                <% } %>
            </div>
        </div>

        <!-- DESCRIPTION -->
        <div class="info-group">
            <span class="info-label">Mô tả</span>
            <div class="info-value description"><%= room.description %></div>
        </div>

        <!-- PRICE -->
        <div class="info-group">
            <span class="info-label">Giá phòng</span>
            <div class="info-value large">
                <%= room.price.toLocaleString('vi-VN') %> VNĐ / đêm
            </div>
        </div>

        <!-- PROVIDER INFO -->
        <div class="info-group">
            <span class="info-label">Thông tin nhà cung cấp</span>
            <div class="provider-card">
                <div class="provider-item">
                    <strong>Tên:</strong> <%= room.Provider?.providerName || 'N/A' %>
                </div>
                <div class="provider-item">
                    <strong>Email:</strong> <%= room.Provider?.email || 'N/A' %>
                </div>
                <div class="provider-item">
                    <strong>Phone:</strong> <%= room.Provider?.phoneNumber || 'N/A' %>
                </div>
            </div>
        </div>

        <!-- STATUS -->
        <div class="info-group">
            <span class="info-label">Trạng thái</span>
            <% if (room.status === 'Hoạt động') { %>
                <span class="status-badge-large status-approved">Hoạt động</span>
            <% } else { %>
                <span class="status-badge-large status-rejected"><%= room.status %></span>
            <% } %>
        </div>

        <!-- APPROVAL STATUS -->
        <div class="info-group">
            <span class="info-label">Trạng thái duyệt</span>
            <% if (room.approvalStatus === 'Chờ duyệt') { %>
                <span class="status-badge-large status-pending">Chờ duyệt</span>
            <% } else if (room.approvalStatus === 'Đã duyệt') { %>
                <span class="status-badge-large status-approved">Đã duyệt</span>
            <% } else { %>
                <span class="status-badge-large status-rejected"><%= room.approvalStatus %></span>
            <% } %>
        </div>

        <!-- POSTED AT -->
        <div class="info-group">
            <span class="info-label">Ngày đăng</span>
            <div class="info-value">
                <%= room.postedAt ? room.postedAt.toLocaleString('vi-VN') : 'Không có' %>
            </div>
        </div>

    </div>

    <!-- Action Section -->
    <div class="action-section">
        <h3 class="action-title">Hành động quản lý</h3>
        <div class="action-buttons">
            <form action="/admin/rooms/<%= room.roomId %>/approve" method="POST">
                <button type="submit" class="btn-approve">Duyệt bài</button>
            </form>

            <form action="/admin/rooms/<%= room.roomId %>/reject" method="POST">
                <input type="text" name="reason" class="reason-input" placeholder="Nhập lý do từ chối..." required>
                <button type="submit" class="btn-reject">Từ chối</button>
            </form>
        </div>
    </div>

</div>

<%- include('../partials/footer-admin') %>
