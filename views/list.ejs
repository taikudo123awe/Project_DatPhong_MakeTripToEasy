<%- include('partials/header') %>

  <div class="container my-4">
    <!-- Thanh tiêu đề và nút trở về -->
    <%- include('partials/search-bar') %>
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary">Kết quả tìm kiếm</h3>
        <a href="/" class="btn btn-outline-secondary">
          ⬅️ Quay lại trang chủ
        </a>
      </div>

      <div class="row">
        <!-- Cột trái: Bộ lọc -->
        <div class="col-md-3">
          <div class="card shadow-sm border-0">
            <div class="card-body">
              <h5 class="fw-bold mb-3">Bộ lọc</h5>
              <form action="/rooms/search" method="get">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Loại phòng</label>
                  <div>
                    <% if (roomTypes && roomTypes.length> 0) { %>
                      <% roomTypes.forEach(type=> {
                        const selectedTypes = Array.isArray(filters?.typeIds) ? filters.typeIds.map(id => parseInt(id)) : filters?.typeIds ? [parseInt(filters.typeIds)] : [];
                      %>
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" name="typeId" value="<%= type.typeId %>" id="type_<%= type.typeId %>" <%=selectedTypes.includes(type.typeId) ? "checked" : "" %>
                          >
                          <label class="form-check-label" for="type_<%= type.typeId %>"> <%= type.typeName %> </label>
                        </div>
                        <% }) %>
                          <% } else { %>
                            <p class="text-muted small">Không có loại phòng nào trong hệ thống</p>
                          <% } %>
                  </div>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Giá mỗi đêm</label>
                  <input type="range" class="form-range" min="400000" max="10000000" step="200000" id="priceRange"
                    name="priceRange" value="<%= filters?.priceRange || 5000000 %>"
                    oninput="document.getElementById('priceValue').textContent = Number(this.value).toLocaleString('vi-VN') + ' VND'">
                  <small class="text-muted"> Giá tối đa: <span id="priceValue">
                      <%= filters?.priceRange ? filters.priceRange.toLocaleString('vi-VN') : '5,000,000' %> VND
                    </span>
                  </small>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Sức chứa</label>
                  <select class="form-select" name="capacity">
                    <option value="" <%=!filters?.capacity ? "selected" : "" %>>Tất cả</option>
                    <option value="1" <%=filters?.capacity==1 ? "selected" : "" %>>1 người</option>
                    <option value="2" <%=filters?.capacity==2 ? "selected" : "" %>>2 người</option>
                    <option value="3" <%=filters?.capacity==3 ? "selected" : "" %>>3 người</option>
                    <option value="4" <%=filters?.capacity==4 ? "selected" : "" %>>4 người</option>
                    <option value="5" <%=filters?.capacity==5 ? "selected" : "" %>>5+ người</option>
                  </select>
                </div>

                <a href="/rooms/search" class="btn btn-outline-secondary w-100">
                  <i class="fa-solid fa-rotate-left"></i> Đặt lại bộ lọc
                </a>
                <button type="submit" class="btn btn-primary w-100">Áp dụng bộ lọc</button>
              </form>
            </div>
          </div>
        </div>

        <!-- Cột phải: Danh sách phòng -->
        <div class="col-md-9">
          <% if (rooms.length===0) { %>
            <div class="alert alert-warning text-center">
              Không tìm thấy phòng trống phù hợp với yêu cầu của bạn.
            </div>
            <% } else { %>
              <p class="text-muted mb-3">
                🔍 Tìm thấy <strong>
                  <%= rooms.length %>
                </strong> chỗ nghỉ phù hợp
              </p>

              <div class="row g-4">
                <% rooms.forEach(room=> { %>
                  <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                      <img src="/<%= room.image ? room.image.split(';')[0] : '/default-room.jpg' %>"
                        class="card-img-top" alt="<%= room.roomName %>" style="height:220px;object-fit:cover;">

                      <div class="card-body d-flex flex-column">
                        <h6 class="card-title fw-bold text-primary mb-1">
                          <%= room.roomName %>
                        </h6>
                        <p class="text-muted mb-1"><i class="fa-solid fa-location-dot"></i>
                          <%= room.Address?.city || 'Không rõ địa điểm' %>
                        </p>
                        <p class="small mb-2">👥 Sức chứa: <%= room.capacity %> người</p>
                        <p class="fw-bold text-danger mb-3">
                          <%= room.price.toLocaleString() %> VND / đêm
                        </p>

                        <a href="/rooms/<%= room.roomId %>?checkInDate=<%= encodeURIComponent(searchParams.checkInDate) %>&checkOutDate=<%= encodeURIComponent(searchParams.checkOutDate) %>&numberOfGuests=<%= searchParams.numGuests %>"
                          class="btn btn-primary mt-auto">
                          Xem chi tiết
                        </a>
                      </div>
                    </div>
                  </div>
                  <% }) %>
              </div>
              <% } %>
        </div>
      </div>
  </div>

  <%- include('partials/footer') %>