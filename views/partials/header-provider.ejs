  <link rel="stylesheet" href="/css/provider-sidebar.css" />

  <div class="provider-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      
    <!-- ⭐ TOP BRAND HEADER -->
    <div class="brand-logo-box">
      <i class="fas fa-plane-departure brand-icon"></i>
      <h2 class="brand-title">Make Trip To Easy</h2>
    </div>

      <!-- logo + tên doanh nghiệp -->
      <div class="business-info">
        <% if (providerInfo && providerInfo.profileImage) { %>
          <img src="/<%= providerInfo.profileImage %>" class="business-logo" />
        <% } else { %>
          <div class="business-logo placeholder-logo"><i class="fa-solid fa-image"></i></div>
        <% } %>

        <h3 class="business-name">
          <%= providerInfo?.businessName || "Tên doanh nghiệp" %>
        </h3>
      </div>

      <!-- MENU -->
      <nav class="menu">
        <a href="/provider/dashboard"
          class="menu-item <%= active === 'dashboard' ? 'active' : '' %>">
          📘 Quản lý phòng
        </a>

        <a href="/provider/bookings"
          class="menu-item <%= active === 'bookings' ? 'active' : '' %>">
          📅 Quản lý đơn
        </a>

        <a href="/provider/report"
          class="menu-item <%= active === 'report' ? 'active' : '' %>">
          📊 Báo cáo
        </a>

        <a href="/provider/reviews"
          class="menu-item <%= active === 'reviews' ? 'active' : '' %>">
          ⭐ Quản lý đánh giá
        </a>

        <a href="/provider/profile"
          class="menu-item <%= active === 'profile' ? 'active' : '' %>">
          🏢 Hồ sơ doanh nghiệp
        </a>

        <a href="/provider/edit-profile"
          class="menu-item <%= active === 'edit-profile' ? 'active' : '' %>">
          ⚙️ Tài khoản
        </a>
      </nav>


      <!-- USER -->
      <div class="sidebar-footer">
        <div class="user-box">
          <i class="fa-solid fa-circle-user"></i>
          <span><%= provider?.providerName || provider?.fullName || "Nhà cung cấp" %></span>
        </div>
        <a href="/logout" class="logout-btn">
          <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
        </a>
      </div>
    </aside>

    <!-- ⭐ KHUNG NỘI DUNG TRANG ⭐ -->
    <div class="provider-content">
  <% if (typeof body !== 'undefined' && body !== "") { %>
      <%- body %>
  <% } %>
