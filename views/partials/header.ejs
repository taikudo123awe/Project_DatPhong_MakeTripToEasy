<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Make Trip To Easy - Đặt phòng dễ dàng</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="/styles/partials/header.css">
</head>

<body>
  <!-- Header -->
  <header class="header">
    <nav class="navbar navbar-expand-lg container">
      <a class="navbar-brand" href="/">
        <i class="fas fa-plane-departure"></i> Make Trip To Easy
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/"><i class="fas fa-home"></i> Trang chủ</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/rooms"><i class="fas fa-bed"></i> Phòng</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/customer/history"><i class="fas fa-credit-card"></i> Thanh toán</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/provider/dashboard"><i class="fas fa-hotel"></i> Đăng chỗ nghĩ của
              quý vị</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/contact"><i class="fas fa-envelope"></i> Liên hệ</a>
          </li>
          <% if (customer) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="customerMenu" role="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                Xin chào, <%= customer.fullName %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="customerMenu">
                <li><a class="dropdown-item" href="/customer/profile"><i class="fas fa-user"></i> Thông
                    tin cá nhân</a></li>
                <li><a class="dropdown-item" href="/customer/history-dashboard"><i class="fas fa-calendar-check"></i>
                    Phiếu đặt phòng</a></li>
                <li><a class="dropdown-item" href="/customer/logout"><i class="fas fa-sign-out"></i>
                    Đăng xuất</a></li>
              </ul>
            </li>
            <% } else { %>
              <li class="nav-item">
                <a class="nav-link" href="/customer/login"><i class="fas fa-sign-in"></i> Đăng nhập</a>
              </li>
              <% } %>
        </ul>
      </div>
    </nav>
  </header>