<div class="container search-bar">
  <form action="/rooms/search" method="get" class="row g-3 align-items-end">

    <!-- Cột 1: Địa điểm -->
    <!-- Thành phố -->
    <div class="col-md-3">
      <label class="form-label fw-semibold">Thành phố</label>
      <select name="city" id="city" class="form-select">
        <option value="">-- Chọn thành phố --</option>
      </select>
      <input type="hidden" id="cityName" name="cityName">
    </div>

    <!-- Quận/Huyện -->
    <div class="col-md-3">
      <label class="form-label fw-semibold">Quận/Huyện</label>
      <select name="district" id="district" class="form-select" disabled>
        <option value="">-- Chọn quận/huyện --</option>
      </select>
      <input type="hidden" id="districtName" name="districtName">
    </div>

    <!-- Phường/Xã -->
    <div class="col-md-3">
      <label class="form-label fw-semibold">Phường/Xã</label>
      <select name="ward" id="ward" class="form-select" disabled>
        <option value="">-- Chọn phường/xã --</option>
      </select>
      <input type="hidden" id="wardName" name="wardName">
    </div>

    <!-- Cột 2: Ngày -->
    <div class="col-md-3">
      <label class="form-label fw-semibold">Ngày nhận - trả phòng</label>
      <input type="text" id="dateRange" name="dateRange" class="form-control" readonly placeholder="Chọn ngày">
    </div>

    <!-- Cột 3: Số người lớn và phòng -->
    <!-- 👥 Bộ chọn khách & phòng -->
    <div class="col-md-6 position-relative">
      <label class="form-label fw-semibold">Khách & phòng</label>
      <input type="text" id="guestSummary" class="form-control" readonly value="2 người ở · 1 phòng">
      <input type="hidden" name="numberOfGuests" id="hiddenGuests" value="2">
      <input type="hidden" name="quantity" id="hiddenRooms" value="1">

      <!-- Dropdown chọn -->
      <div id="guestOptions" class="card shadow p-3 position-absolute"
        style="z-index: 2000; display:none; width: 240px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span>Người ở</span>
          <div>
            <button type="button" class="btn btn-sm btn-outline-secondary"
              onclick="changeGuests('adults', -1)">-</button>
            <span id="adultsCount" class="mx-2">2</span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
              onclick="changeGuests('adults', 1)">+</button>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>Phòng</span>
          <div>
            <button type="button" class="btn btn-sm btn-outline-secondary"
              onclick="changeGuests('rooms', -1)">-</button>
            <span id="roomsCount" class="mx-2">1</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="changeGuests('rooms', 1)">+</button>
          </div>
        </div>
        <button type="button" class="btn btn-primary btn-sm mt-2 w-100" onclick="closeGuests()">Xong</button>
      </div>
    </div>

    <!-- Cột 4: Nút tìm kiếm -->
    <div class="col-md-1 d-grid">
      <button class="btn btn-primary btn-search h-80 mt-1 mt-md-4" type="submit">
        <i class="fa-solid fa-magnifying-glass me-1"></i>
      </button>
    </div>
  </form>
</div>

<script src="/javascript/addressAPI.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  flatpickr("#dateRange", { mode: "range", dateFormat: "Y-m-d" });
</script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">