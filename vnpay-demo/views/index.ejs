<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>VNPay Demo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-5">
    <h2 class="mb-4 text-center">Demo Thanh toán qua VNPay (QR/Redirect)</h2>

    <div class="text-end mb-4">
      <a href="/create-booking" class="btn btn-primary">+ Tạo đơn đặt phòng mẫu</a>
    </div>

    <% if (bookings.length === 0) { %>
      <div class="alert alert-warning text-center">Chưa có đơn hàng nào!</div>
    <% } else { %>
      <table class="table table-bordered bg-white shadow-sm">
        <thead class="table-light">
          <tr>
            <th>Mã đơn</th>
            <th>Tên khách hàng</th>
            <th>Tổng tiền (VNĐ)</th>
            <th>Trạng thái</th>
            <th>Thanh toán</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td><%= b.code %></td>
              <td><%= b.customerName %></td>
              <td><%= b.totalAmount.toLocaleString() %></td>
              <td>
                <% if (b.status === 'paid') { %>
                  <span class="badge bg-success">Đã thanh toán</span>
                <% } else { %>
                  <span class="badge bg-secondary">Chưa thanh toán</span>
                <% } %>
              </td>
              <td>
                <% if (b.status === 'pending') { %>
                  <form method="POST" action="/vnpay/create" style="display:inline;">
                    <input type="hidden" name="code" value="<%= b.code %>">
                    <button type="submit" class="btn btn-sm btn-success">Thanh toán qua VNPay</button>
                  </form>
                <% } else { %>
                  <a href="/payment-success/<%= b.code %>" class="btn btn-sm btn-outline-success">Xem</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
